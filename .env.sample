MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=tviy_hub_db
MYSQL_USER=tviyhub_user
MYSQL_PASSWORD=tviyhub_password
MYSQL_LOCAL_PORT=3306
MYSQLDB_DOCKER_PORT=3306
# Required, at least 32 characters, e.g. generate with: openssl rand -base64 48
JWT_SECRET=
