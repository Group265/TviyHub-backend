MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=tviy_hub_db
MYSQL_USER=tviyhub_user
MYSQL_PASSWORD=tviyhub_password
MYSQL_LOCAL_PORT=3306
MYSQLDB_DOCKER_PORT=3306
# Required, at least 32 characters, e.g. generate with: openssl rand -base64 48
JWT_SECRET=
# Optional: access token lifetime in minutes (default 15), refresh token lifetime in days (default 30)
# JWT_EXPIRATION_MINUTES=15
# JWT_REFRESH_EXPIRATION_DAYS=30
# First administrator, created at startup when there is none. These defaults are for development and testing ONLY:
# set your own before running anywhere real, or disable it with ADMIN_BOOTSTRAP_ENABLED=false.
# ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=12345678
# ADMIN_BOOTSTRAP_ENABLED=true
# Email (verification and reset codes): the shared team SMTP settings are in .env.team, so leave MAIL_* out.
# To use your own SMTP, uncomment and fill these (they override .env.team):
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@tviyhub.local
STRIPE_SECRET_KEY=sk_test_51_...
