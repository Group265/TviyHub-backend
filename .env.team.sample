# Template of .env.team (shared SMTP settings of the team). The real .env.team is NOT in git:
# get it from the team (password manager) and put it in the project root. Without it
# (and without MAIL_* in your .env) confirmation codes are only written to the application log.
#
# IMPORTANT FOR TESTERS: Brevo only accepts connections from allowed IP addresses.
# Before testing emails, add YOUR public IP in Brevo: Security -> Authorized IPs
# (find your IP at https://api.ipify.org). Without it registration fails with 503
# and the log shows "525 5.7.1 Unauthorized IP address" or "535 Authentication failed".
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=<SMTP login from Brevo, like xxxxxxxx@smtp-brevo.com>
MAIL_PASSWORD=<SMTP key from Brevo, starts with xsmtpsib->
MAIL_FROM=<sender address verified in Brevo>
